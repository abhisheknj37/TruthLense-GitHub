# Optional model overrides
TRUTHLENS_IMAGE_MODEL=sakshamkr1/deitfake-v2
TRUTHLENS_AUDIO_MODEL=Hemgg/Deepfake-audio-detection

# Heuristic score bands only; these are NOT calibrated confidence thresholds
TRUTHLENS_FAKE_THRESHOLD=0.65
TRUTHLENS_REAL_THRESHOLD=0.35

# Firebase Admin SDK (required to protect authenticated API routes)
FIREBASE_PROJECT_ID=your-firebase-project-id
# Local development: place the downloaded service-account JSON in backend/
# and set this path. Never commit the service-account file.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Alternative for deployment: store the complete service-account JSON in a
# secret environment variable and leave FIREBASE_SERVICE_ACCOUNT_PATH blank.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# On Google Cloud, Application Default Credentials can be used instead.

# Comma-separated browser origins permitted to call this API (adjust for deployment)
TRUTHLENS_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Persistent server-side case records and model attribution images
# Defaults to backend/data/ when these are not set.
# TRUTHLENS_DATABASE_PATH=./data/truthlens.sqlite3
# TRUTHLENS_DATA_DIR=./data
# Optional advanced-forensics configuration
# All paths below are interpreted on the BACKEND machine. Do not commit .env or weights.
# Trained temporal classifier: compatible TorchScript checkpoint; no weights are bundled.
# Expected input tensor: RGB float32 [1,T,3,224,224] with values in [0,1].
# TRUTHLENS_TEMPORAL_MODEL=./models/temporal_classifier.pt

# InsightFace model pack (downloads on first use when the optional package is installed).
TRUTHLENS_FACE_MODEL=buffalo_l
# Heuristic within-video cosine-similarity review threshold; not an identity decision.
TRUTHLENS_FACE_SIMILARITY_REVIEW_THRESHOLD=0.35

# Compatible SyncNet checkpoint; SyncNet also needs syncnet-python and FFmpeg on PATH.
# TRUTHLENS_SYNCNET_WEIGHTS=./models/syncnet_v2.model

# Optional speech-recognition checkpoint supported by Transformers ASR pipeline.
# First use may download model weights; choose a checkpoint compatible with your hardware.
# TRUTHLENS_ASR_MODEL=

# Optional custom Tesseract executable path (Windows example; remove # to enable).
# TRUTHLENS_TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe

# Optional local evidence-ledger database path.
# TRUTHLENS_LEDGER_DB=./data/evidence_ledger.sqlite3

# Optional Hugging Face cache directory for downloaded model weights.
# HF_HOME=./model-cache

# Optional Supabase cloud mirror. Keep the service-role key on the backend only.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
