# Firebase Web app config (Firebase Console → Project settings → Your apps)
# These web configuration values are public client configuration, not service-account secrets.
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-web-app-id
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# Optional: change if your API is deployed somewhere other than localhost.
VITE_API_URL=http://127.0.0.1:8000
